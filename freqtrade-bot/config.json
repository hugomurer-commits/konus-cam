{
    "$schema": "https://schema.freqtrade.io/schema.json",

    "bot_name": "konus-bot",

    "max_open_trades": 5,
    "stake_currency": "USDT",
    "stake_amount": 100,
    "tradable_balance_ratio": 0.99,
    "fiat_display_currency": "BRL",
    "timeframe": "1h",

    "dry_run": true,
    "dry_run_wallet": 1000,

    "trading_mode": "spot",
    "margin_mode": "",

    "cancel_open_orders_on_exit": false,
    "force_entry_enable": false,

    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },

    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },

    "exit_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },

    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "ccxt_config": {},
        "ccxt_async_config": {},
        "pair_whitelist": [
            "BTC/USDT",
            "ETH/USDT",
            "BNB/USDT",
            "SOL/USDT",
            "XRP/USDT",
            "ADA/USDT",
            "AVAX/USDT",
            "LINK/USDT",
            "DOT/USDT",
            "LTC/USDT",
            "ATOM/USDT",
            "NEAR/USDT",
            "TRX/USDT",
            "DOGE/USDT"
        ],
        "pair_blacklist": [
            ".*UP/USDT",
            ".*DOWN/USDT",
            ".*BULL/USDT",
            ".*BEAR/USDT",
            "BUSD/.*",
            "USDC/.*",
            "TUSD/.*",
            "FDUSD/.*"
        ]
    },

    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],

    "telegram": {
        "enabled": false,
        "token": "",
        "chat_id": ""
    },

    "api_server": {
        "enabled": false,
        "listen_ip_address": "127.0.0.1",
        "listen_port": 8080,
        "verbosity": "error",
        "enable_openapi": false,
        "jwt_secret_key": "TROQUE_ISTO_NO_config.secrets.json",
        "ws_token": "TROQUE_ISTO_NO_config.secrets.json",
        "CORS_origins": [],
        "username": "",
        "password": ""
    },

    "initial_state": "running",

    "internals": {
        "process_throttle_secs": 5
    },

    "dataformat_ohlcv": "feather",
    "db_url": "sqlite:///user_data/tradesv3.sqlite"
}
